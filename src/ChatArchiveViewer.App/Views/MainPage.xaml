<Page
    x:Class="ChatArchiveViewer.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="CloudFetchInfoBar"
                 Grid.Row="0"
                 Margin="12,8,12,0"
                 IsClosable="False"
                 IsOpen="False"
                 Severity="Warning" />

        <NavigationView x:Name="RootNavigation"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="BrowseNavItem"
                                    Icon="Library" />
                <NavigationViewItem x:Name="SearchNavItem"
                                    Icon="Find"
                                    Visibility="Collapsed" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsNavItem"
                                    Icon="Setting" />
                <NavigationViewItem x:Name="AboutNavItem"
                                    Icon="Help" />
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Page>
