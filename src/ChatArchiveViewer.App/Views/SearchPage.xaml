<Page
    x:Class="ChatArchiveViewer.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="16"
          RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
            <TextBox x:Name="SearchKeywordBox"
                     MinWidth="280"
                     TextChanged="OnSearchKeywordTextChanged" />
            <Button x:Name="SearchButton"
                    Click="OnSearchButtonClick"
                    IsEnabled="False" />
        </StackPanel>
        <ListView x:Name="SearchResultsList"
                  Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding ConversationDisplayName}" />
                        <TextBlock Opacity="0.8"
                                   Text="{Binding Date}" />
                        <TextBlock TextWrapping="WrapWholeWords"
                                   Text="{Binding Message.Text}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
