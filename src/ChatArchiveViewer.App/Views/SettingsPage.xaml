<Page
    x:Class="ChatArchiveViewer.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="16"
          RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="ThemeLabelText"
                   FontWeight="SemiBold" />
        <ComboBox x:Name="ThemeComboBox"
                  Grid.Row="1"
                  SelectionChanged="OnThemeSelectionChanged" />
        <Button x:Name="SaveSettingsButton"
                Grid.Row="2"
                Click="OnSaveSettingsClick" />
    </Grid>
</Page>
